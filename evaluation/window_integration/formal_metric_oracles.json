  "cases": [
    {
      "id": "F01",
      "test": "test_real_cash_batch_is_complete_and_account_specific",
      "expected": {
        "main_cash_minor": 2289000,
        "savings_cash_minor": 150000,
        "cash_total_minor": 2439000,
        "holding_principal_minor": 800000,
        "as_of": "2026-10-03",
        "kind": "recorded_fact"
      }
    },
    {
      "id": "F02",
      "test": "test_real_hypothesis_projection_preserves_complete_local_binding",
      "inputs": {
        "operation": "subtract",
        "values_minor": [
          13579,
          579
        ],
        "currency": "CNY"
      },
      "expected": {
        "result_minor": 13000,
        "kind": "hypothesis",
        "basis": "user_input_arithmetic_not_account_data",
        "formula_id": "tools.money_hypothesis/1",
        "assumed_inputs": [
          {
            "type": "user_hypothesis",
            "input_index": 0,
            "value_minor": 13579
          },
          {
            "type": "user_hypothesis",
            "input_index": 1,
            "value_minor": 579
          }
        ]
      }
    },
    {
      "id": "F03",
      "test": "test_service_rules_are_conditional_not_current_cash",
      "expected": {
        "kind": "planning_scenario",
        "basis": "approved_conditional_service_terms_not_cash",
        "data_scope": "navren_synthetic_service_terms_not_cash",
        "offers": {
          "SYNTH-E-STATEMENT-FEE-90D": {
            "monthly_value": 500,
            "max_cost": 1500,
            "minimum_monthly_salary": 0,
            "period_start": "2026-10-01",
            "period_end": "2026-12-31",
            "duration_months": 3
          },
          "SYNTH-PAYROLL-FEE-180D": {
            "monthly_value": 1000,
            "max_cost": 6000,
            "minimum_monthly_salary": 600000,
            "period_start": "2026-10-01",
            "period_end": "2026-11-30",
            "duration_months": 6
          }
        }
      }
    },
    {
      "id": "F04",
      "test": "test_base_rejects_tool_amount_and_type_forgery",
      "expected": {
        "code": "METRIC_RESULT_MISMATCH"
      }
    },
    {
      "id": "F05",
      "test": "test_signed_real_batch_rejects_mutation_and_other_workspace",
      "expected": {
        "tamper_code": "METRIC_TAMPERED",
        "subject_code": "METRIC_SUBJECT_MISMATCH"
      }
    },
    {
      "id": "F06",
      "test": "test_agent_rejects_same_amount_wrong_object_period_currency_basis",
      "expected": {
        "code": "METRIC_CLAIM_MISMATCH"
      }
    },
    {
      "id": "F07",
      "test": "test_agent_rejects_wrong_amount_and_condition_relabel",
      "expected": {
        "amount_code": "METRIC_LITERAL_MISMATCH",
        "kind_code": "METRIC_KIND_MISMATCH"
      }
    },
    {
      "id": "F08",
      "test": "test_real_batches_cannot_merge_changed_source_versions",
      "expected": {
        "code": "METRIC_SOURCE_VERSION_CONFLICT"
      }
    },
    {
      "id": "F09",
      "test": "test_source_change_before_prepare_rejects_without_new_operation",
      "expected": {
        "code": "STALE_EVIDENCE",
        "new_operations": 0,
        "cash_change_minor": 0
      }
    },
    {
      "id": "F10",
      "test": "test_source_change_before_final_answer_and_locked_release_rejects",
      "expected": {
        "agent_code": "STALE_EVIDENCE",
        "base_code": "METRIC_VERSION_CONFLICT"
      }
    },
    {
      "id": "F11",
      "test": "test_cashflow_prepare_keeps_existing_excluded_pending_source_valid",
      "inputs": {
        "days": 60,
        "transfer_amount_minor": 10000
      },
      "expected": {
        "state": "pending_confirmation",
        "cash_change_minor": 0,
        "fresh_after_prepare": true,
        "pending_operation_kind": "planning_scenario",
        "pending_excluded": "pending_operations_not_counted"
      }
    },
    {
      "id": "F12",
      "test": "test_locked_response_guard_accepts_real_batch_then_rejects_changed_pending_state",
      "inputs": {
        "transfer_amount_minor": 10000
      },
      "expected": {
        "state": "pending_confirmation",
        "after_confirmation_balance_minor": 2279000,
        "pending_operation_kind": "planning_scenario",
        "expired_code": "STALE_OPERATION_METRICS",
        "cash_change_minor": 0
      }
    }
  ],
